# Ignore everything
*

# Except these
!.gitignore
!CLAUDE.md
!settings.json
!skills/
!skills/**
!code-style/
!code-style/**
!refs/
!refs/**
!snippets/
!snippets/**
!aiusage-hook.sh
!commands/
!commands/**
!agents/
!agents/**
!context/
!context/**
!hooks/
!hooks/**
!.claude/
!.claude/todos/
!.claude/todos/**
!favicon.svg
!favicon.png
!favicon.ico

# Per-user ticket log, not shared
skills/shortcut-create-ticket/log.md

# Runtime artifact written by /commit's build watch, per-machine
skills/commit/watch-build.pid

# Claims are machine-local state (session ids, PIDs) - never commit, even though todos/ above is tracked
.claude/todos/.claims/
.claude/todos/.claims/**

# Python bytecode cache, regenerated locally, not source
hooks/__pycache__/
hooks/__pycache__/**
**/__pycache__/
**/__pycache__/**

# commit-guard/pr-guard runtime markers - machine/session-local, never commit
hooks/.commit-marker*
hooks/.pr-marker*

# Belt-and-suspenders: never commit secrets
.env
**/.env
.env.bak
**/.env.bak
.DS_Store