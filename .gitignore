# Ignore everything
*

# Except these
!.gitignore
!CLAUDE.md
!settings.json
!skills/
!skills/**
!code-style/
!code-style/**
!refs/
!refs/**
!snippets/
!snippets/**
!output-styles/
!output-styles/**
!aiusage-hook.sh
!commands/
!commands/**
!agents/
!agents/**
!context/
!context/**
!hooks/
!hooks/**
!.claude/
!.claude/todos/
!.claude/todos/**
!favicon.svg
!favicon.png
!favicon.ico
!ci/
!ci/**
!.github/
!.github/**

# Per-user ticket log, not shared
skills/ticket/log.md

# Runtime artifact written by /commit's build watch, per-machine
skills/commit/watch-build.pid

# Playwright browser profiles - 419 files of per-machine runtime state that `!skills/**` above
# would otherwise re-include, putting them in every git status in this repo.
skills/*/playwright-profiles/

# Claims are machine-local state (session ids, PIDs) - never commit, even though todos/ above is tracked
.claude/todos/.claims/
.claude/todos/.claims/**

# Id-reservation markers are transient runtime state, consumed the moment the real todo file
# is written - never commit, even though todos/ above is tracked
.claude/todos/*-.reserved

# Python bytecode cache, regenerated locally, not source
hooks/__pycache__/
hooks/__pycache__/**
**/__pycache__/
**/__pycache__/**

# Status cache that lands here when a tool runs with cwd=hooks/. Nothing in this repo writes or
# reads it: grepping hooks/ for last-session-status, session_status and checkedAt found no producer.
hooks/.claude/
hooks/.claude/**

# commit-guard/pr-guard runtime markers - machine/session-local, never commit
hooks/.commit-marker*
hooks/.pr-marker*
hooks/.session-markers/
hooks/.ui-screenshot-reminder-session-*

# Belt-and-suspenders: never commit secrets
.env
**/.env
.env.bak
**/.env.bak
.DS_Store