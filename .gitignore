# Ignore everything
*

# Except these
!.gitignore
!CLAUDE.md
!settings.json
!skills/
!skills/**
!code-style/
!code-style/**
!refs/
!refs/**
!snippets/
!snippets/**
!aiusage-hook.sh
!commands/
!commands/**
!agents/
!agents/**
!context/
!context/**
!.claude/
!.claude/todos/
!.claude/todos/**
!favicon.svg
!favicon.png
!favicon.ico

# Per-user ticket log, not shared
skills/shortcut-create-ticket/log.md

# Runtime artifact written by /commit's build watch, per-machine
skills/commit/watch-build.pid

# Claims are machine-local state (session ids, PIDs) - never commit, even though todos/ above is tracked
.claude/todos/.claims/
.claude/todos/.claims/**

# Belt-and-suspenders: never commit secrets
.env
**/.env
.env.bak
**/.env.bak
.DS_Store