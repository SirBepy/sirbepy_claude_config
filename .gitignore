# Ignore everything
*

# Except these
!.gitignore
!CLAUDE.md
!settings.json
!skills/
!skills/**
!code-style/
!code-style/**
!refs/
!refs/**
!snippets/
!snippets/**
!output-styles/
!output-styles/**
!aiusage-hook.sh
!commands/
!commands/**
!agents/
!agents/**
!context/
!context/**
!hooks/
!hooks/**
!.claude/
!.claude/todos/
!.claude/todos/**
!favicon.svg
!favicon.png
!favicon.ico
!ci/
!ci/**
!tools/
!tools/**
!.github/
!.github/**

# The Claude app syncs its own managed skills here; machine-local, not authored in this repo
skills/synced/

# Disposable scratch: .for_bepy/ is per-project throwaway output, stackdumps are crash residue
**/.for_bepy/
*.stackdump

# impeccable's per-platform engine binary (17 MB), reinstalled by `npx impeccable update`; its
# hooks no-op when the file is absent
skills/impeccable/scripts/bin/

# Per-user ticket log, not shared
skills/ticket/log.md

# Runtime artifact written by /commit's build watch, per-machine
skills/commit/watch-build.pid

# Claims are machine-local state (session ids, PIDs) - never commit, even though todos/ above is tracked
.claude/todos/.claims/
.claude/todos/.claims/**

# Id-reservation markers are transient runtime state, consumed the moment the real todo file
# is written - never commit, even though todos/ above is tracked
.claude/todos/*-.reserved

# Per-commit push clearances written by hooks/push-gate.py mark, machine-local state
hooks/.push-ok/

# Session-scoped night-commit approvals written by hooks/commit-window-guard.py allow, machine-local state
hooks/.commit-window-ok/

# Python bytecode cache, regenerated locally, not source
hooks/__pycache__/
hooks/__pycache__/**
**/__pycache__/
**/__pycache__/**

# Status cache that lands here when a tool runs with cwd=hooks/. Nothing in this repo writes or
# reads it: grepping hooks/ for last-session-status, session_status and checkedAt found no producer.
hooks/.claude/
hooks/.claude/**
.claude/todos/.claude/
.claude/todos/.claude/**

# Guard runtime markers - machine/session-local, never commit. All four glob families defined
# in hooks/*.py are listed here; _hooklib.py:19 is the outbound one.
hooks/.commit-marker*
hooks/.pr-marker*
hooks/.outbound-marker*
hooks/.shortcut-marker*
hooks/.session-markers/
hooks/.ui-screenshot-reminder-session-*
hooks/.testing-floor-pending/
hooks/.testing-floor-skip

# Belt-and-suspenders: never commit secrets
.env
**/.env
.env.bak
**/.env.bak
.DS_Store

# impeccable's per-project hook dedup cache, rewritten on every UI edit
**/.impeccable/hook.cache.json
